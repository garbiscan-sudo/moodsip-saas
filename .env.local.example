# ─────────────────────────────────────────────────────
#  MoodSip SaaS — Ortam Değişkenleri
#  Bu dosyayı .env.local olarak kaydedin
#  Vercel'e deploy ederken bunları Environment Variables'a ekleyin
# ─────────────────────────────────────────────────────

# Supabase — https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role (sadece server-side, asla client'a vermeyin)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# İyzico — https://merchant.iyzipay.com → Ayarlar → Güvenlik
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlıya geçince: https://api.iyzipay.com

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canlıya geçince: https://moodsip.com

# Fiyatlandırma (TL, kuruş cinsinden değil, tam TL)
NEXT_PUBLIC_PRICE_MONTHLY=299
NEXT_PUBLIC_PRICE_YEARLY=2490
